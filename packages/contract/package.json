{
  "name": "@todo/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The only definition of the Todo API: types, TypeBox schemas, paths, error codes",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
