{
  "name": "@todo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Todo HTTP API: Fastify routes, TodoService, SQLite repository (better-sqlite3)",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
