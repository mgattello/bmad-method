  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.3.0",
    "@todo/contract": "*",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "tsx": "4.23.15"
  }
}
