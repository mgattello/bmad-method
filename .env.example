# Reference only: nothing loads this file. Export variables in the shell (compose sets them in containers).
# apps/api (read only in src/server.ts)
HOST=0.0.0.0
PORT=3000
DB_PATH=/data/todos.db
LOG_LEVEL=info
NODE_ENV=production

# apps/web dev server proxy target for /api (never inlined into the bundle)
API_PROXY_TARGET=http://localhost:3000

# docker compose: host port that publishes the web container
WEB_PORT=8080
