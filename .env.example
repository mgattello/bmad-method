# Reference only: nothing loads this file. Export variables in the shell (compose sets them in containers).
# apps/api (read only in src/server.ts)
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# apps/api container values set by compose; override them for a local run
DB_PATH=/data/todos.db
# the dev profile's api-dev uses DB_PATH=/data/dev.db on the same todo-data volume
NODE_ENV=production

# apps/web dev server proxy target for /api (never inlined into the bundle)
API_PROXY_TARGET=http://localhost:3000

# docker compose: host port that publishes the web container
# A copied .env next to docker-compose.yml changes only WEB_PORT; everything else is set by compose's environment: blocks
WEB_PORT=8080
